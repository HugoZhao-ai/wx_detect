# 复制为 .env 后填写。不要把 .env 发给任何人或提交到 Git。
WECHAT_GROUP_NAME=多空双杀华尔街
WECHAT_TARGET_MEMBER=吹峰机
WECHAT_ALERT_CONTACT_REMARK=王庆鹏
WECHAT_ALERT_CONTACT_NICKNAME=Windy & Warm

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30

ALERT_CONFIDENCE_THRESHOLD=0.85
DEDUPE_MINUTES=10
CALLS_PER_HOUR=5
CALL_MAX_ATTEMPTS=2
CALL_RETRY_SECONDS=60

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SILK_SAMPLE_RATE=24000
VOICE_DOWNLOAD_RETRIES=6
VOICE_DOWNLOAD_RETRY_SECONDS=2
KEEP_VOICE_HOURS=24

LISTENER_INTERVAL_SECONDS=0.8
TARGET_CONTEXT_MESSAGES=8
TARGET_CONTEXT_WINDOW_SECONDS=300
LOG_LEVEL=INFO

# 安全默认值：完成 doctor、probe 和 test-alert 后再改为 true。
CALLS_ENABLED=false
SEND_ALERT_MESSAGE=true
DRY_RUN=true
